/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/images/*
  Cache-Control: public, max-age=2592000
  X-Content-Type-Options: nosniff

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # NOTE: the hosts below are load-bearing. GitHub Pages ignores this file
  # today, but the moment the site moves to Netlify/Cloudflare Pages this
  # policy is enforced — and a missing host means 100% loss of tracking
  # (connect-src) or 100% loss of leads (connect-src / form-action).
  # connect-src must allow: the click-guard beacon worker, the lead gateway,
  # the Web3Forms fallback and GTM/Clarity/GA4.
  # form-action must allow: 'self' (the Netlify form POST) + the lead hosts.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms https://www.google-analytics.com https://region1.google-analytics.com https://visit-log.sachindeepcleaning.workers.dev https://lead-gateway.sachindeepcleaning.workers.dev https://api.web3forms.com https://wa.me https://*.wa.me; frame-src 'self' https://www.googletagmanager.com https://www.youtube.com https://www.youtube-nocookie.com https://maps.google.com https://wa.me https://*.wa.me; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https://lead-gateway.sachindeepcleaning.workers.dev https://api.web3forms.com https://wa.me https://*.wa.me
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/llms.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/sitemap-images.xml
  Cache-Control: public, max-age=3600

/sitemap-videos.xml
  Cache-Control: public, max-age=3600

/*.html
  Cache-Control: public, max-age=600, must-revalidate

# If the site stays on GitHub Pages and you add Cloudflare in front instead of
# moving hosts, reproduce these rules as Cloudflare "Cache Rules":
#
#   Cache Rule 1 (hashed build assets):
#     When:  Hostname equals sachindeepcleaning.shop  AND  URI path starts with /assets/  OR  URI path starts with /fonts/
#     Then:  Cache Eligibility = Eligible  ·  Browser TTL = 1 year  ·  Edge TTL = 1 year  ·  Cache Key = ignore query string
#   Cache Rule 2 (images — content can change on redeploy):
#     When:  Hostname equals sachindeepcleaning.shop  AND  URI path starts with /images/
#     Then:  Cache Eligibility = Eligible  ·  Browser TTL = 30 days  ·  Edge TTL = 30 days
#   Cache Rule 3 (HTML — keep the 10-minute proxy TTL so a deploy goes live fast):
#     When:  Hostname equals sachindeepcleaning.shop  AND  URI path ends with .html  OR  URI path equals /
#     Then:  Browser TTL = 10 minutes  ·  Edge TTL = 10 minutes
#
# Cloudflare then serves the hashed /assets and /fonts with
# `cache-control: max-age=31536000, immutable` to the browser, and /images with
# 30 days — matching this file.

/.well-known/*
  Cache-Control: public, max-age=3600
